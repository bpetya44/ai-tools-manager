# Frontend Environment Variables
# Copy this file to .env.local and update values as needed

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8201/api

# Application Configuration
NEXT_PUBLIC_APP_NAME=AI Tools Manager
NEXT_PUBLIC_APP_URL=http://localhost:8200

# Development Configuration
NODE_ENV=development

# Optional: Analytics (if needed)
# NEXT_PUBLIC_GA_ID=your_google_analytics_id

# Optional: Error Tracking (if needed)
# NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
